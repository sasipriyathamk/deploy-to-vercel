# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.).
# Required in production. Local `next dev` falls back to embedded Postgres in .data/pglite.
DATABASE_URL=

# Optional PEM CA certificate when your host requires a custom CA.
DATABASE_CA_CERT=

# Helius free plan: https://dashboard.helius.dev/
# Used for the webhook receiver auth pairing and, when set, a gentler RPC fallback.
HELIUS_API_KEY=
# If set, POST /api/webhooks/helius requires Authorization: Bearer <secret>
HELIUS_WEBHOOK_SECRET=

# Jupiter free portal key: https://developers.jup.ag/portal
# Keyless works at about 0.5 rps. A free key raises the budget.
JUPITER_API_KEY=

# Signature-poll fallback. Leave unset to use public mainnet RPC,
# or Helius RPC automatically when HELIUS_API_KEY is set.
PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Required in production. cron-job.org, the daily Vercel fallback, and a manual
# GitHub Actions run all send Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Shadow AI thesis verdict. Optional. Missing values mark the verdict unavailable
# and the recheck pipeline still finishes. Do not commit real values.
# OpenAI-compatible gateway base URL and key. Already set in Vercel when used.
OMO_AI_GATEWAY_URL=
OMO_MODEL_API_KEY=
# Privy refresh token for the fomo.family holder thesis feed.
FOMO_PRIVY_REFRESH_TOKEN=
# Cheap fast default is google/gemini-2.5-flash. Daily cap counts model calls per IST day.
AI_VERDICT_MODEL=
AI_VERDICT_DAILY_CAP=

# Set to 1 to run the in-process queue worker outside development.
# ENABLE_LOCAL_WORKER=1
# Set to 1 to signature-poll on boot (off by default; use the Poll button or cron).
# POLL_ON_BOOT=1

# Telegram alerts (off until migration/configuration are reviewed).
# Confidence >=75; one delivery per mint; ambiguous sends require reconciliation.
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Required only for reviewed application of the new Telegram alert/milestone migrations.
# Separate from delivery; leave disabled until schema changes are approved.
ALLOW_ALERT_MIGRATIONS=0

# Optional separate key for Settings > Export database. Defaults to CRON_SECRET.
EXPORT_SECRET=
